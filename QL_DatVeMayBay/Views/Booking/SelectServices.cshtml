@using QL_DatVeMayBay.Models
@{
    ViewData["Title"] = "Bước 3: Chọn Chỗ Ngồi & Dịch Vụ";
    var draft = ViewBag.Draft as BookingDraftModel;
    var legs = ViewBag.Legs as List<Dictionary<string, object>> ?? new();
    var bagServices = ViewBag.BaggageAndTransitServices as List<Dictionary<string, object>> ?? new();
    var mealServices = ViewBag.MealServices as List<Dictionary<string, object>> ?? new();
    int soGheCanChon = ViewBag.SoGheCanChon ?? 1;
    decimal estFare = ViewBag.EstimatedFareTotal ?? 0m;
    decimal estTax = ViewBag.EstimatedTaxTotal ?? 0m;
    var firstLeg = legs.First();
    var lastLeg = legs.Last();
    string destImg = lastLeg.ContainsKey("HinhAnhDiemDen") && !string.IsNullOrEmpty(lastLeg["HinhAnhDiemDen"]?.ToString())
        ? lastLeg["HinhAnhDiemDen"].ToString()!
        : $"/images/destinations/{lastLeg["MaSanBayDen"]}.jpg";
}

<style>
    .vj-svc-row {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 14px;
        transition: all .15s; box-shadow: 0 2px 8px rgba(15,23,42,.04);
    }
    .vj-svc-row:hover { border-color: #ef4444; box-shadow: 0 6px 16px rgba(15,23,42,.08); }
    .vj-offcanvas { width: 465px !important; max-width: 96vw !important; }
</style>

<div class="container py-4">
    <!-- HEADER BƯỚC 3 KIỂU VIETJET -->
    <div class="p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3 rounded-4 shadow-sm" style="background: linear-gradient(90deg, #facc15, #fde047);">
        <div>
            <div class="fw-bold small text-uppercase">BƯỚC 3 / 4 • @(draft!.Passengers.Count) HÀNH KHÁCH</div>
            <div class="fw-bold text-danger fs-5">
                @firstLeg["ThanhPhoDi"] (@firstLeg["MaSanBayDi"]) → @lastLeg["ThanhPhoDen"] (@lastLeg["MaSanBayDen"])
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-circle bg-white text-success p-2"><i class="bi bi-check-lg"></i></span>
            <span class="badge rounded-circle bg-white text-success p-2"><i class="bi bi-check-lg"></i></span>
            <span class="badge rounded-circle bg-success text-white p-2"><i class="bi bi-cart-fill"></i></span>
            <span class="badge rounded-circle bg-white text-secondary p-2"><i class="bi bi-qr-code"></i></span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold rounded-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</span>
            <a asp-action="Passengers"
               asp-route-maChuyenBayDi="@draft.MaChuyenBayDi"
               asp-route-hangGheDi="@draft.HangGheDi"
               asp-route-maChuyenBayDi2="@draft.MaChuyenBayDi2"
               asp-route-maChuyenBayVe="@draft.MaChuyenBayVe"
               asp-route-hangGheVe="@draft.HangGheVe"
               asp-route-maChuyenBayVe2="@draft.MaChuyenBayVe2"
               asp-route-nguoiLon="@draft.NguoiLon"
               asp-route-treEm="@draft.TreEm"
               asp-route-emBe="@draft.EmBe"
               asp-route-maKM="@draft.MaKM"
               class="btn btn-light btn-sm text-danger fw-bold rounded-pill">
                ← Quay lại sửa thông tin hành khách
            </a>
        </div>
    }
    <div id="realtimeAlert" class="alert alert-info d-none fw-semibold rounded-4"></div>

    <form method="post" asp-action="ConfirmServicesAndHold" id="servicesForm">
        <div class="row g-4">
            <!-- CỘT TRÁI: CHỈ 3 DỊCH VỤ CHUẨN VIETJET -->
            <div class="col-lg-7">
                <p class="fw-semibold text-success mb-3">Đừng quên mua hành lý, suất ăn, chọn chỗ ngồi yêu thích...</p>

                <!-- 1. CHỌN CHỖ NGỒI YÊU THÍCH (MỞ NGĂN KÉO MÔ HÌNH MÁY BAY BÊN PHẢI GIỐNG VIETJET) -->
                <div class="vj-svc-row p-3 mb-3 d-flex justify-content-between align-items-center" style="cursor:pointer;"
                     data-bs-toggle="offcanvas" data-bs-target="#seatOffcanvas">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-warning-subtle text-danger p-3 fs-3"><i class="bi bi-grid-3x3-gap-fill"></i></div>
                        <div>
                            <div class="fw-bold fs-6">Chọn chỗ ngồi yêu thích</div>
                            <div class="small text-muted" id="selectedSeatSummaryLine">Bấm để mở sơ đồ mô hình máy bay &amp; chọn chỗ ngồi</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-danger small" id="seatFeeBadge">0 VNĐ</div>
                        <span class="badge bg-danger rounded-pill px-3 mt-1">Chọn ghế ›</span>
                    </div>
                </div>

                <!-- 2. CHỌN HÀNH LÝ / DỊCH VỤ NỐI CHUYẾN -->
                <div class="vj-svc-row p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#bagCollapse">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-danger-subtle text-danger p-3 fs-3"><i class="bi bi-luggage-fill"></i></div>
                            <div>
                                <div class="fw-bold fs-6">Chọn hành lý / Dịch vụ nối chuyến</div>
                                <div class="small text-muted">Hãy lựa chọn gói hành lý ký gửi &amp; ưu tiên nối chuyến phù hợp</div>
                            </div>
                        </div>
                        <span class="fw-bold text-danger" id="bagFeeBadge">0 VNĐ ›</span>
                    </div>
                    <div class="collapse show mt-3 pt-3 border-top" id="bagCollapse">
                        <div class="row g-2">
                            @foreach (var dv in bagServices)
                            {
                                decimal gia = Convert.ToDecimal(dv["DonGia"]);
                                <div class="col-md-6">
                                    <div class="form-check border rounded-3 p-2 h-100">
                                        <input class="form-check-input svc-bag" type="checkbox" name="selectedServiceIds" value="@dv["MaDV"]" id="dv_@dv["MaDV"]" data-price="@gia" onchange="recalcServiceTotal()">
                                        <label class="form-check-label w-100 small" for="dv_@dv["MaDV"]">
                                            <strong>@dv["TenDV"]</strong> <span class="badge bg-info text-dark float-end">+@gia.ToString("N0")đ</span>
                                            <div class="text-muted" style="font-size:.73rem;">@dv["MoTa"]</div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 3. CHỌN SUẤT ĂN (SKY CAFÉ) -->
                <div class="vj-svc-row p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#mealCollapse">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-success-subtle text-success p-3 fs-3"><i class="bi bi-cup-hot-fill"></i></div>
                            <div>
                                <div class="fw-bold fs-6">Chọn suất ăn <span class="text-danger fst-italic">Sky Café</span></div>
                                <div class="small text-muted">Chọn suất ăn nóng phục vụ ngay trên chuyến bay</div>
                            </div>
                        </div>
                        <span class="fw-bold text-danger" id="mealFeeBadge">0 VNĐ ›</span>
                    </div>
                    <div class="collapse show mt-3 pt-3 border-top" id="mealCollapse">
                        <div class="row g-2">
                            @foreach (var dv in mealServices)
                            {
                                decimal gia = Convert.ToDecimal(dv["DonGia"]);
                                <div class="col-md-6">
                                    <div class="form-check border rounded-3 p-2 h-100">
                                        <input class="form-check-input svc-meal" type="checkbox" name="selectedServiceIds" value="@dv["MaDV"]" id="dv_@dv["MaDV"]" data-price="@gia" onchange="recalcServiceTotal()">
                                        <label class="form-check-label w-100 small" for="dv_@dv["MaDV"]">
                                            <strong>@dv["TenDV"]</strong> <span class="badge bg-warning text-dark float-end">+@gia.ToString("N0")đ</span>
                                            <div class="text-muted" style="font-size:.73rem;">@dv["MoTa"]</div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: KHUNG THÔNG TIN ĐẶT CHỖ -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden sticky-top" style="top: 85px;">
                    <div class="bg-danger text-white p-3 fw-bold">THÔNG TIN ĐẶT CHỖ</div>
                    <div class="card-body bg-white p-3 small">
                        <div class="fw-bold mb-1">Thông tin hành khách (@draft.Passengers.Count):</div>
                        <ul class="ps-3 mb-2 text-muted">
                            @foreach (var p in draft.Passengers)
                            {
                                <li><strong>@p.TenHanhKhach</strong> (@p.LoaiHanhKhach • @p.LoaiGiayTo: @p.SoGiayTo)</li>
                            }
                        </ul>
                        <hr />
                        @foreach (var l in legs)
                        {
                            <div class="mb-1"><strong>@l["LegLabel"]:</strong> @l["MaChuyenBay"] (@l["MaSanBayDi"] → @l["MaSanBayDen"])</div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-1"><span>Giá vé:</span><strong>@estFare.ToString("N0") VNĐ</strong></div>
                        <div class="d-flex justify-content-between mb-1"><span>Thuế, phí:</span><strong>@estTax.ToString("N0") VNĐ</strong></div>
                        <div class="d-flex justify-content-between mb-1"><span>Dịch vụ (Ghế + Hành lý + Suất ăn):</span><strong class="text-primary" id="sideServiceTotal">0 VNĐ</strong></div>
                    </div>
                    <div class="bg-danger text-white p-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Tổng tiền</span>
                        <span class="fs-5 fw-bold" id="sideGrandTotal">@((estFare + estTax).ToString("N0")) VNĐ</span>
                    </div>
                    <div class="p-3 bg-light d-flex gap-2">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary fw-semibold">Quay lại</a>
                        <button type="submit" class="btn btn-warning flex-grow-1 fw-bold rounded-pill shadow-sm">
                            Đi tiếp → Thanh toán Mã QR
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- NGĂN KÉO PHẢI (VIETJET OFFCANVAS SEAT MAP DRAWER) NẰM TRONG FORM ĐỂ SUBMIT CÙNG LÚC -->
        <div class="offcanvas offcanvas-end vj-offcanvas" tabindex="-1" id="seatOffcanvas" aria-labelledby="seatOffcanvasLabel">
            <div class="bg-danger text-white p-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-uppercase" id="seatOffcanvasLabel">CHỌN CHỖ NGỒI YÊU THÍCH</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>

            <div class="offcanvas-body p-0 d-flex flex-column">
                <div class="p-3 bg-white border-bottom">
                    @if (legs.Count > 1)
                    {
                        <ul class="nav nav-pills nav-fill mb-2 gap-1" role="tablist">
                            @for (int li = 0; li < legs.Count; li++)
                            {
                                var l = legs[li];
                                <li class="nav-item">
                                    <button type="button" class="nav-link py-1 small fw-bold @(li == 0 ? "active bg-danger text-white" : "bg-light text-dark")"
                                            data-bs-toggle="pill" data-bs-target="#pane_@l["MaChuyenBay"]">
                                        @l["LegLabel"]
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center fw-bold small mb-2">Chuyến đi</div>
                    }

                    <!-- THẺ HÀNH KHÁCH MÀU ĐỎ GIỐNG VIETJET -->
                    <div class="rounded-3 p-2 text-center text-white mb-2 shadow-sm" style="background: linear-gradient(90deg, #b91c1c, #dc2626);">
                        <div class="small opacity-90">Hành khách</div>
                        <div class="fw-bold text-uppercase">@string.Join(", ", draft.Passengers.Where(p => p.LoaiHanhKhach != "Em bé").Select(p => p.TenHanhKhach))</div>
                        <div class="small bg-white text-dark rounded mt-1 py-1 fw-bold">
                            @firstLeg["MaSanBayDi"] - @lastLeg["MaSanBayDen"]
                        </div>
                    </div>

                    <!-- BANNER ẢNH THẬT ĐIỂM ĐẾN GIỐNG VIETJET -->
                    <div class="position-relative rounded-3 overflow-hidden" style="height: 82px;">
                        <img src="@destImg" onerror="this.src='/images/destinations/@(lastLeg["MaSanBayDen"]).svg'" class="w-100 h-100 object-fit-cover" alt="Destination" />
                        <div class="position-absolute inset-0 d-flex align-items-center p-2 text-white"
                             style="top:0;left:0;right:0;bottom:0;background:linear-gradient(90deg, rgba(15,23,42,.78), rgba(15,23,42,.2));">
                            <small class="fw-semibold">Chỗ ngồi chuẩn ý cho bạn một chuyến bay thoải mái hài lòng</small>
                        </div>
                    </div>
                </div>

                <!-- THÂN MÁY BAY CUỘN ĐƯỢC -->
                <div class="p-3 flex-grow-1 overflow-auto bg-light">
                    <div class="tab-content">
                        @for (int li = 0; li < legs.Count; li++)
                        {
                            var leg = legs[li];
                            string maCB = leg["MaChuyenBay"].ToString()!;
                            string huong = leg["HuongBay"].ToString()!;
                            int thuTu = Convert.ToInt32(leg["ThuTuChang"]);
                            string inputName = (huong == "DI" && thuTu == 1) ? "gheDiIds"
                                             : (huong == "DI" && thuTu == 2) ? "gheDi2Ids"
                                             : (huong == "VE" && thuTu == 1) ? "gheVeIds"
                                             : "gheVe2Ids";

                            <div class="tab-pane fade @(li == 0 ? "show active" : "")" id="pane_@maCB">
                                @await Html.PartialAsync("_AircraftSeatMap", null, new ViewDataDictionary(ViewData)
                                {
                                    { "Leg", leg },
                                    { "InputName", inputName },
                                    { "OnChangeFn", "onSeatPick" },
                                    { "MaxSeats", soGheCanChon }
                                })
                            </div>
                        }
                    </div>
                </div>

                <!-- CHÂN NGĂN KÉO MÀU ĐỎ GIỐNG VIETJET -->
                <div class="bg-danger text-white p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small opacity-90">Chỗ ngồi</div>
                        <div class="fw-bold fs-6" id="drawerSeatFee">0 VNĐ</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-warning fw-bold btn-sm px-3" data-bs-dismiss="offcanvas" onclick="clearSeatChoices()">
                            Không, cảm ơn
                        </button>
                        <button type="button" class="btn btn-light text-danger fw-bold btn-sm px-3" data-bs-dismiss="offcanvas">
                            Xác nhận ✓
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const baseAndTax = @(estFare + estTax);
    const hasServerError = @(TempData["Error"] != null ? "true" : "false");
    const legCodes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(legs.Select(l => l["MaChuyenBay"].ToString()).Distinct()));

    // Tự động mở ngăn kéo chọn chỗ ngồi ngay khi vào Bước 3 (nếu không có thông báo lỗi cần người dùng xử lý)
    document.addEventListener('DOMContentLoaded', () => {
        if (hasServerError) return;
        const el = document.getElementById('seatOffcanvas');
        if (el && window.bootstrap) {
            new bootstrap.Offcanvas(el).show();
        }
    });

    function clearSeatChoices() {
        document.querySelectorAll('input[data-seatid]:checked').forEach(x => x.checked = false);
        document.getElementById('selectedSeatSummaryLine').textContent = 'Không chọn trước — Hệ thống sẽ tự xếp ghế trống miễn phí theo hạng vé.';
        recalcServiceTotal();
    }

    function onSeatPick(groupName, max, maCB) {
        const checked = document.querySelectorAll('.chk-' + groupName + ':checked');
        if (checked.length > max) checked[0].checked = false;
        const active = Array.from(document.querySelectorAll('.chk-' + groupName + ':checked'));

        const descBox = document.getElementById('seatDescBox_' + maCB);
        if (descBox) {
            if (active.length === 0) {
                descBox.innerHTML = 'Bấm vào biểu tượng ghế để xem vị trí chính xác.';
            } else {
                const last = active[active.length - 1];
                descBox.innerHTML = `<strong class="text-success">✓ ${last.dataset.desc}</strong>`;
                document.getElementById('selectedSeatSummaryLine').textContent =
                    active.map(a => a.dataset.code).join(', ') + ' — ' + last.dataset.desc;
            }
        }
        recalcServiceTotal();
    }

    function recalcServiceTotal() {
        let seatFee = 0, bagFee = 0, mealFee = 0;
        document.querySelectorAll('input[data-seatid]:checked').forEach(x => {
            const addCost = parseFloat(x.dataset.addcost || x.dataset.fee || '0');
            seatFee += addCost;
        });
        document.querySelectorAll('.svc-bag:checked').forEach(x => bagFee += parseFloat(x.dataset.price || '0'));
        document.querySelectorAll('.svc-meal:checked').forEach(x => mealFee += parseFloat(x.dataset.price || '0'));

        document.getElementById('seatFeeBadge').textContent = seatFee.toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('drawerSeatFee').textContent = seatFee.toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('bagFeeBadge').textContent = bagFee.toLocaleString('vi-VN') + ' VNĐ ›';
        document.getElementById('mealFeeBadge').textContent = mealFee.toLocaleString('vi-VN') + ' VNĐ ›';

        const svcSum = seatFee + bagFee + mealFee;
        document.getElementById('sideServiceTotal').textContent = svcSum.toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('sideGrandTotal').textContent = (baseAndTax + svcSum).toLocaleString('vi-VN') + ' VNĐ';
    }

    const conn = new signalR.HubConnectionBuilder().withUrl("/seatHub").withAutomaticReconnect().build();
    conn.on("SeatStatusChanged", function (data) {
        (data.seatIds || []).forEach(id => {
            const chk = document.getElementById(`seat_${data.maChuyenBay}_${id}`);
            const lbl = document.getElementById(`lbl_${data.maChuyenBay}_${id}`);
            if (chk && lbl) {
                chk.checked = false;
                chk.disabled = !!data.isOccupied;
                if (data.isOccupied) {
                    lbl.innerHTML = data.seatState === 'sold'
                        ? '<span class="vj-sold-box">✕</span>'
                        : '<span class="vj-held-box">🔒</span>';
                }
            }
        });
        recalcServiceTotal();
        const alertBox = document.getElementById("realtimeAlert");
        alertBox.textContent = data.message || "Sơ đồ ghế vừa cập nhật thời gian thực!";
        alertBox.classList.remove("d-none");
    });
    conn.start().then(() => legCodes.forEach(c => conn.invoke("JoinFlightRoom", c)));
</script>
