@using Microsoft.AspNetCore.Http
@{
    var userType = Context.Session.GetString("UserType"); // "KH" hoặc "NV"
    var userName = Context.Session.GetString("UserName");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyVN Air | Bay là thích ngay!</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- 1. THANH THÔNG BÁO ĐỎ TRÊN CÙNG -->
    <div class="vj-top-bar py-2 no-print">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="text-truncate">
                <span class="fw-bold">[THÔNG BÁO]</span> Mở bán vé Tết 2027 & Ưu đãi giảm đến 20% khi nhập mã <strong>HE2026</strong> tại SkyVN Air.
            </div>
            <div class="d-none d-md-flex align-items-center gap-2 small opacity-75">
                <i class="bi bi-chevron-left"></i>
                <span>• • •</span>
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>

    <!-- 2. NAVBAR TRẮNG TINH GỌN KIỂU VIETJET -->
    <header class="sticky-top no-print">
        <nav class="navbar navbar-expand-lg vj-navbar py-2">
            <div class="container">
                <a class="navbar-brand vj-logo d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    SkyVN Air<span>.com</span>
                </a>
                <span class="text-muted mx-2 d-none d-lg-inline">|</span>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link vj-nav-link" asp-controller="Home" asp-action="Index">Tìm chuyến bay</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link vj-nav-link" asp-controller="CheckIn" asp-action="Index">Online Check-in</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link vj-nav-link" asp-controller="Booking" asp-action="Lookup">Tra cứu PNR / Đổi hủy</a>
                        </li>
                        @if (userType == "KH")
                        {
                            <li class="nav-item">
                                <a class="nav-link vj-nav-link text-danger" asp-controller="Booking" asp-action="MyBookings">Chuyến bay của tôi</a>
                            </li>
                        }
                        @if (userType == "NV")
                        {
                            <li class="nav-item">
                                <a class="nav-link vj-nav-link text-danger" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>Trung tâm Điều hành
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 small">
                        <span class="text-muted d-none d-xl-inline"><i class="bi bi-headset me-1"></i>Hỗ trợ 1900 1008</span>
                        <span class="text-muted d-none d-xl-inline"><i class="bi bi-globe me-1"></i>Tiếng Việt</span>
                        <span class="text-muted d-none d-xl-inline fw-semibold">VND</span>

                        @if (string.IsNullOrEmpty(userName))
                        {
                            <a class="btn btn-vj-yellow btn-sm px-4 py-2 rounded-pill" asp-controller="Account" asp-action="Login">
                                Đăng nhập
                            </a>
                            <a class="btn btn-outline-danger btn-sm px-3 py-2 rounded-pill fw-semibold" asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        }
                        else
                        {
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-person-circle text-danger me-1"></i>@userName
                            </span>
                            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-light text-secondary py-4 mt-5 no-print border-top">
        <div class="container">
            <div class="row align-items-center small">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span class="fw-bold text-danger fst-italic">SkyVN Air.com</span> — Hệ Thống Quản Lý Đặt Vé Máy Bay Nội Địa Việt Nam
                </div>
                <div class="col-md-6 text-center text-md-end">
                    Đồ án Phân tích Thiết kế Hệ thống Thông tin - Nhóm 10 (HUIT) &copy; 2026
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Di chuyển các Bootstrap modal ra thẳng body để không bị kẹt dưới .modal-backdrop khi nằm trong container có transform
            document.querySelectorAll('.modal').forEach(m => {
                if (m.parentElement !== document.body) {
                    document.body.appendChild(m);
                }
            });
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, idx) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => entry.target.classList.add('is-visible'), idx * 50);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.08 });

            document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>