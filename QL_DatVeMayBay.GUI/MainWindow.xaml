<Window x:Class="QL_DatVeMayBay.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QL_DatVeMayBay.GUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="TRA CỨU CHUYẾN BAY" FontSize="20" FontWeight="Bold" 
                   Foreground="#005A9E" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Thanh tìm kiếm -->
        <GroupBox Header="Thông tin tìm kiếm" Grid.Row="1" Margin="0,0,0,15" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Mã SB Đi:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="txtMaSBDi" Width="100" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock Text="Mã SB Đến:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox x:Name="txtMaSBDen" Width="100" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock Text="Ngày Bay:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <DatePicker x:Name="dpNgayBay" Width="120" Height="25"/>

                <Button x:Name="btnTimKiem" Content="Tìm Kiếm" Width="90" Height="25" Margin="20,0,5,0" 
                        Background="#005A9E" Foreground="White" FontWeight="Bold" Click="btnTimKiem_Click"/>
                <Button x:Name="btnLamMoi" Content="Làm Mới" Width="80" Height="25" Margin="5,0" 
                        Click="btnLamMoi_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Bảng hiển thị kết quả -->
        <DataGrid x:Name="dgvChuyenBay" Grid.Row="2" AutoGenerateColumns="True" 
                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"/>
    </Grid>
</Window>
