<UserControl x:Class="QL_DatVeMayBay.GUI.Views.QuanLyChuyenBayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QL_DatVeMayBay.GUI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:ChuyenBayViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Thanh lọc / Tìm kiếm -->
            <RowDefinition Height="*"/>
            <!-- Danh sách DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Thanh công cụ thao tác -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ CHUYẾN BAY" 
                   FontSize="22" FontWeight="Bold" Foreground="#1E88E5" Margin="0,0,0,15"/>

        <!-- BỘ LỌC TÌM KIẾM -->
        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="5" Padding="12" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <!-- Sân bay đi -->
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="Sân bay đi:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox Width="180" Height="30"
                              ItemsSource="{Binding DanhSachSanBay}"
                              DisplayMemberPath="TenSanBay"
                              SelectedValuePath="MaSanBay"
                              SelectedValue="{Binding SelectedSanBayDi}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Sân bay đến -->
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="Sân bay đến:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox Width="180" Height="30"
                              ItemsSource="{Binding DanhSachSanBay}"
                              DisplayMemberPath="TenSanBay"
                              SelectedValuePath="MaSanBay"
                              SelectedValue="{Binding SelectedSanBayDen}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- DatePicker Chọn ngày bay -->
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="Ngày bay:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker Width="150" Height="30" SelectedDate="{Binding NgayBayChon}"/>
                </StackPanel>

                <!-- Các nút hành động tìm kiếm -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <Button Content="Tìm kiếm" Command="{Binding TimKiemCommand}" 
                            Width="90" Height="30" Background="#1E88E5" Foreground="White" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" 
                            Width="80" Height="30" Background="#757575" Foreground="White"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- HIỂN THỊ DANH SÁCH CHUYẾN BAY -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding DanhSachChuyenBay}"
                  SelectedItem="{Binding SelectedChuyenBay}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False"
                  Background="White"
                  HeadersVisibility="Column"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã CB" Binding="{Binding MaChuyenBay}" Width="80"/>
                <DataGridTextColumn Header="Hãng bay" Binding="{Binding TenHang}" Width="120"/>
                <DataGridTextColumn Header="Sân bay đi" Binding="{Binding SanBayDi}" Width="150"/>
                <DataGridTextColumn Header="Sân bay đến" Binding="{Binding SanBayDen}" Width="150"/>
                <DataGridTextColumn Header="Ngày giờ bay" Binding="{Binding NgayGioBay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="Thời gian (Phút)" Binding="{Binding ThoiGianBay}" Width="110"/>
                <DataGridTextColumn Header="Giá vé cơ bản" Binding="{Binding GiaVeCoBan, StringFormat={}{0:N0} VNĐ}" Width="120"/>
                <DataGridTextColumn Header="Số ghế trống" Binding="{Binding SoGheTrong}" Width="90"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- HỦY CHUYẾN BAY -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy chuyến bay" Command="{Binding HuyChuyenCommand}" 
                    Width="130" Height="35" Background="#E53935" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>